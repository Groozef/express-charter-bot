# HTTP порт для health-check
PORT=3000

# --- Bot API (получить у @BotFather), бот должен быть добавлен админом в целевой канал ---
BOT_TOKEN=

# Канал-источник, откуда читаем "горящие туры" (юзербот-аккаунт должен состоять в нём)
SOURCE_CHANNEL_ID=-1001534797825

# Ваш канал, куда бот ретранслирует посты
TARGET_CHANNEL_ID=-1004360728939

# --- MTProto / юзербот (получить api_id и api_hash на https://my.telegram.org) ---
TG_API_ID=
TG_API_HASH=
# Заполняется автоматически после "npm run generate:session"
TG_SESSION=

# Пост публикуется почти как есть (без наценки, без подмены контактов). Правки:
# 1) ссылка wa.me с ?text=... зашивается в HTML-тег <a href="...">видимый текст</a>
#    (сообщение уходит с parse_mode: HTML), чтобы не показывать длинную закодированную ссылку.
#    Сторонние сокращатели (is.gd/tinyurl и т.п.) намеренно не используются — их часто
#    помечают антивирусы/браузеры как подозрительные/фишинговые домены
WHATSAPP_TRACKING_TEXT=Здравствуйте! Пишу с канала Express Charter KZ по этому объявлению, прикладываю скриншот 👇

# видимый текст той самой HTML-ссылки
WHATSAPP_LINK_LABEL=📲 Писать со Скрином (WhatsApp)

# 2) под постом (прямо перед строкой с WhatsApp) добавляется короткая подпись-напоминание
# (только если в посте была wa.me-ссылка)
POST_FOOTER_TEXT=📌 Для заявки: скриншот этого поста + не удаляйте текст, который откроется в WhatsApp

# Пути для логов/состояния (внутри контейнера, монтируются как volume)
STATE_FILE_PATH=./data/state.json
RAW_LOG_FILE_PATH=./logs/raw-messages.log
